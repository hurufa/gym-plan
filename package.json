{
  "name": "gym-app",
  "version": "0.1.0",
  "private": true,
  "description": "Offline gym routine and nutrition planner. Dev dependencies only (vendoring, icons, single-file build); the app itself has no runtime dependencies.",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "icons": "node scripts/make-icons.js",
    "precache": "node scripts/precache.js",
    "build": "node scripts/precache.js && node build-single.js",
    "dev": "node scripts/dev-server.mjs",
    "serve": "npx serve ."
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "esbuild": "^0.24.2",
    "gsap": "^3.15.1",
    "sharp": "^0.33.5"
  }
}
